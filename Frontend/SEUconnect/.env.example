# Frontend Environment Variables (Vercel / Local)

# In Vercel Project Settings > Environment Variables:
# Key:   VITE_API_URL
# Value: https://<your-backend-domain>/api  (e.g., https://seuconnect-api.onrender.com/api)
#
# For Local Development (leave blank or use default):
VITE_API_URL=http://localhost:5000/api
