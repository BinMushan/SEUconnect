# Copy to .env (git-ignored). Never commit real values.
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (Atlas > Connect > Drivers). The database name is set separately below.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=seuconnect

# REQUIRED: long random string used to sign login tokens (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Account lockout and rate limits
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT=30
API_RATE_LIMIT=600

# Demo accounts/data share well-known passwords. They are created in development by default and
# NEVER in production unless you set this to true.
# SEED_DEMO_DATA=false

# Optional: comma-separated browser origins allowed by CORS (default: any origin)
# CORS_ORIGIN=http://localhost:5174

# AI assistant (role agents + RAG). Server-side only - never expose this in the frontend.
# Without a key the assistant still answers from your data and the knowledge base (rule-based mode).
# GEMINI_API_KEY=
# GEMINI_MODELS_FAST=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash-lite
# GEMINI_MODELS_SMART=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview
# GEMINI_EMBED_MODEL=gemini-embedding-001
# ASSISTANT_RATE_LIMIT=20

# Cloudinary Media Storage (Images & Documents)
CLOUDINARY_CLOUD_NAME=dtpeeydfz
CLOUDINARY_API_KEY=977493353135588
CLOUDINARY_API_SECRET=

