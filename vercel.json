{
  "version": 2,
  "buildCommand": "npm --prefix Frontend/SEUconnect run build",
  "outputDirectory": "Frontend/SEUconnect/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
